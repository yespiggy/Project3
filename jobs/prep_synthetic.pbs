#!/bin/bash
#PBS -N p3synprep
#PBS -q auto_free
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -e -o pipefail
export P3_ROOT=/home/svu/e0985955/p3-review-20261102/Project3
source "$P3_ROOT/scripts/env.sh"
mkdir -p "$P3_DATA"
export OMP_NUM_THREADS=16
for p in 1 2 4 8 16 36 72 144; do
 f=$P3_DATA/rmat_p$p.bin
 if [ ! -s "$f" ]; then
  "$P3_ROOT/bin/rmat_gen" "$((p * 131072))" 16 "$p" "$f.tmp"
  mv "$f.tmp" "$f"
 fi
done
