#!/bin/bash
# Single-GPU experiments on one A40: validation on web-Google, E4 kernel comparison on LiveJournal, Nsight metrics.
#PBS -N p3gpu
#PBS -q auto_free
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -j oe
source $PBS_O_WORKDIR/../scripts/env.sh
module load cuda12.4/toolkit/12.4.1 >/dev/null 2>&1
cd "$P3_ROOT"
mkdir -p "$P3_RESULTS/val"
BIN=$P3_ROOT/bin
V=$P3_RESULTS/val
nvidia-smi --query-gpu=name,memory.total,driver_version,clocks.max.memory --format=csv

# Validation: every kernel to convergence on web-Google.
$BIN/pagerank_cuda --graph $P3_DATA/web-Google.bin --kernel all --iters 1000 --tol 1e-10 --exp val --out $V/cuda \
  --header 1 > $V/val_gpu.csv

# E4: kernel comparison on LiveJournal (E5 reuses the best kernel).
$BIN/pagerank_cuda --graph $P3_DATA/soc-LiveJournal1.bin --kernel all --iters 50 --tol 0 --reps 5 --exp E4 \
  --header 1 > $P3_RESULTS/e4.csv
cat $P3_RESULTS/e4.csv

# Nsight Compute metrics for one iteration of each kernel (skipped if profiling is not permitted).
module load cuda12.4/nsight/12.4.1 >/dev/null 2>&1
if command -v ncu >/dev/null; then
  for k in thread warp hybrid cusparse; do
    ncu --csv --metrics dram__throughput.avg.pct_of_peak_sustained_elapsed,dram__bytes.sum,gpu__time_duration.sum,sm__warps_active.avg.pct_of_peak_sustained_active,smsp__thread_inst_executed_per_inst_executed.ratio,lts__t_sector_hit_rate.pct \
      $BIN/pagerank_cuda --graph $P3_DATA/soc-LiveJournal1.bin --kernel $k --iters 1 --reps 0 \
      > $P3_RESULTS/ncu_$k.csv 2> $P3_RESULTS/ncu_$k.err || echo "ncu failed for $k"
  done
fi
echo "GPU experiments done $(date)"
