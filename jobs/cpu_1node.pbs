#!/bin/bash
# Single-node CPU experiments (16 cores): validation on web-Google, E1/E2 up to 16 cores, E5 serial baseline.
#PBS -N p3cpu1
#PBS -q auto_free
#PBS -l select=1:ncpus=16:mpiprocs=16:mem=48gb
#PBS -l walltime=03:00:00
#PBS -j oe
source $PBS_O_WORKDIR/../scripts/env.sh
source $P3_ROOT/scripts/run_lib.sh
cd "$P3_ROOT"
mkdir -p "$P3_RESULTS/val"
BIN=$P3_ROOT/bin
LJ=$P3_DATA/soc-LiveJournal1.bin
GG=$P3_DATA/web-Google.bin
PERF="--iters 50 --tol 0 --reps 5"
echo "nodes: ${NODES[*]}"
lscpu | grep -E "Model name|^CPU\(s\)"

# --- Validation (web-Google, run to convergence): serial reference + 4 MPI variants (4 ranks x 4 threads) ---
V=$P3_RESULTS/val
$BIN/pagerank_serial --graph $GG --iters 1000 --tol 1e-10 --exp val --out $V/serial.bin --log $V/serial_resid.csv \
  $(csv_flag $V/val_cpu.csv) >> $V/val_cpu.csv
for part in vertex edge; do
  for comm in allgather ghost; do
    run_mpi 1 4 4 $V/val_cpu.csv $BIN/pagerank_mpi_omp --graph $GG --part $part --comm $comm --iters 1000 --tol 1e-10 \
      --exp val --out $V/mpi_${part}_${comm}.bin
  done
done
echo "validation done $(date)"

# --- E1 (1-16 cores): pure MPI vs MPI+OpenMP ---
for c in 1 2 4 8 16; do
  for mode in mpi hybrid; do
    read n rpn th <<< "$(layout $c $mode)"
    run_mpi $n $rpn $th $P3_RESULTS/e1.csv $BIN/pagerank_mpi_omp --graph $LJ --part edge --comm ghost $PERF --exp E1_$mode
  done
  echo "E1 $c cores done $(date)"
done

# --- E2 (1-16 cores): weak scaling on R-MAT ---
for c in 1 2 4 8 16; do
  read n rpn th <<< "$(layout $c hybrid)"
  run_mpi $n $rpn $th $P3_RESULTS/e2.csv $BIN/pagerank_mpi_omp --graph $P3_DATA/rmat_p$c.bin --part edge --comm ghost \
    $PERF --exp E2
done
echo "E2 done $(date)"

# --- E5: serial baseline on LiveJournal ---
$BIN/pagerank_serial --graph $LJ $PERF --exp E5_serial $(csv_flag $P3_RESULTS/e5_serial.csv) >> $P3_RESULTS/e5_serial.csv
echo "single-node CPU experiments done $(date)"
