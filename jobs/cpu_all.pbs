#!/bin/bash
# All CPU experiments in one 10-node allocation (16 cores per node, 160 cores total):
#   validation on web-Google, E1 strong scaling, E3 design comparison, E2 weak scaling, E5 serial baseline.
#PBS -N p3cpu
#PBS -q auto_free
#PBS -l select=10:ncpus=16:mpiprocs=16:mem=48gb
#PBS -l place=scatter
#PBS -l walltime=05:00:00
#PBS -j oe
source $PBS_O_WORKDIR/../scripts/env.sh
source $P3_ROOT/scripts/run_lib.sh
cd "$P3_ROOT"
mkdir -p "$P3_RESULTS/val"
BIN=$P3_ROOT/bin
LJ=$P3_DATA/soc-LiveJournal1.bin
GG=$P3_DATA/web-Google.bin
CORES="1 2 4 8 16 32 64 128 160"
PERF="--iters 50 --tol 0 --reps 5"
echo "nodes: ${NODES[*]}"
lscpu | grep -E "Model name|^CPU\(s\)"

# --- Validation (web-Google, run to convergence) ---
V=$P3_RESULTS/val
$BIN/pagerank_serial --graph $GG --iters 1000 --tol 1e-10 --exp val --out $V/serial.bin --log $V/serial_resid.csv \
  $(csv_flag $V/val_cpu.csv) >> $V/val_cpu.csv
for part in vertex edge; do
  for comm in allgather ghost; do
    run_mpi 2 4 4 $V/val_cpu.csv $BIN/pagerank_mpi_omp --graph $GG --part $part --comm $comm --iters 1000 --tol 1e-10 \
      --exp val --out $V/mpi_${part}_${comm}.bin
  done
done
echo "validation done $(date)"

# --- E1: strong scaling on LiveJournal, pure MPI vs MPI+OpenMP (edge partition, ghost exchange) ---
for c in $CORES; do
  for mode in mpi hybrid; do
    read n rpn th <<< "$(layout $c $mode)"
    run_mpi $n $rpn $th $P3_RESULTS/e1.csv $BIN/pagerank_mpi_omp --graph $LJ --part edge --comm ghost $PERF --exp E1_$mode
  done
  echo "E1 $c cores done $(date)"
done

# --- E3: design comparison at 64 cores (4 nodes x 16 ranks), 2x2 partition x communication ---
for part in vertex edge; do
  for comm in allgather ghost; do
    run_mpi 4 16 1 $P3_RESULTS/e3.csv $BIN/pagerank_mpi_omp --graph $LJ --part $part --comm $comm $PERF --exp E3
  done
done
echo "E3 done $(date)"

# --- E2: weak scaling on R-MAT (~2M edges per core), MPI+OpenMP ---
for c in $CORES; do
  read n rpn th <<< "$(layout $c hybrid)"
  run_mpi $n $rpn $th $P3_RESULTS/e2.csv $BIN/pagerank_mpi_omp --graph $P3_DATA/rmat_p$c.bin --part edge --comm ghost \
    $PERF --exp E2
  echo "E2 $c cores done $(date)"
done

# --- E5: serial baseline on LiveJournal ---
$BIN/pagerank_serial --graph $LJ $PERF --exp E5_serial $(csv_flag $P3_RESULTS/e5_serial.csv) >> $P3_RESULTS/e5_serial.csv
echo "all CPU experiments done $(date)"
