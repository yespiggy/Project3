#!/bin/bash
# Override select at submission for the cross-node case; no queue specified.
#PBS -N p3gpuverify
#PBS -l select=1:ncpus=8:mpiprocs=2:ngpus=2:mem=96gb
#PBS -l walltime=00:20:00
#PBS -j oe
set -e -o pipefail
BASE=$(cd "$PBS_O_WORKDIR/.." && pwd)
OUT="$BASE/results/gpu_followup_${PBS_JOBID}"
mkdir -p "$OUT/source"
# Isolated build per job: concurrent jobs cannot replace each other's binaries.
cp -R "$BASE/src" "$BASE/tools" "$BASE/scripts" "$OUT/source/"
git -C "$BASE" rev-parse HEAD > "$OUT/code_commit.txt"
git -C "$BASE" diff > "$OUT/uncommitted.patch"
export P3_ROOT="$OUT/source" P3_RESULTS="$OUT"
source "$P3_ROOT/scripts/env.sh"
module load cuda12.4/toolkit/12.4.1
source "$P3_ROOT/scripts/run_lib.sh"
cd "$P3_ROOT"
bash scripts/build.sh > "$OUT/build.log" 2>&1
test -x "$BIN/pagerank_mpi_cuda"
module list > "$OUT/modules.txt" 2>&1
mpirun --version > "$OUT/mpi_version.txt"
nvcc --version > "$OUT/cuda_version.txt"
qstat -f "$PBS_JOBID" > "$OUT/job_start.txt" 2>&1 || true
gpu_map > "$OUT/gpu_mapping.txt" 2>&1
MPIRUN="$MPIRUN --report-bindings"
for h in "${NODES[@]}"; do
 ssh -o BatchMode=yes -o ConnectTimeout=10 "$h" 'hostname; lscpu; nvidia-smi -L; nvidia-smi topo -m' > "$OUT/hardware_${h}.txt" 2>&1
done
case ${#NODES[@]} in
 1) TWO_N=1; TWO_RPN=2;;
 2) TWO_N=2; TWO_RPN=1;;
 *) echo 'Expected 1 or 2 nodes'; exit 1;;
esac
G="$P3_DATA/soc-LiveJournal1.bin"
test -s "$G"
V="$OUT/validation"; mkdir -p "$V"
"$BIN/pagerank_serial" --graph "$G" --iters 20 --tol 0 --reps 1 --out "$V/serial.bin" --header 1 > "$V/serial.csv"
for count in 1 2; do
 n=1; rpn=1
 if [ "$count" = 2 ]; then n=$TWO_N; rpn=$TWO_RPN; fi
 run_mpi "$n" "$rpn" 4 "$V/runs.csv" "$P3_ROOT/scripts/gpu_wrap.sh" "$BIN/pagerank_mpi_cuda" --graph "$G" --kernel thread,hybrid --iters 20 --tol 0 --reps 1 --out "$V/mpi_${count}gpu" --exp fixed20_validation
done
python3 tools/validate_fixed_vectors.py "$G" "$V"
# Version-controlled timing evidence, with matched 1-GPU baselines.
for graph in soc-LiveJournal1 com-friendster; do
 G="$P3_DATA/$graph.bin"
 if [ ! -s "$G" ]; then echo "SKIP missing graph: $G"; continue; fi
 it=50; [ "$graph" = com-friendster ] && it=20
 for count in 1 2; do
  n=1; rpn=1
  if [ "$count" = 2 ]; then n=$TWO_N; rpn=$TWO_RPN; fi
  run_mpi "$n" "$rpn" 4 "$OUT/performance.csv" "$P3_ROOT/scripts/gpu_wrap.sh" "$BIN/pagerank_mpi_cuda" --graph "$G" --kernel thread,hybrid --iters "$it" --tol 0 --reps 5 --exp gpu_report_followup
 done
done
echo "Completed successfully: $OUT"
