#!/bin/bash
# Validation against the serial result and NetworkX, plus web-Google data findings.
#PBS -N p3post
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=00:30:00
#PBS -j oe
source $PBS_O_WORKDIR/../scripts/env.sh
cd "$P3_ROOT/tools"
python3 validate.py $P3_DATA/web-Google.bin $P3_RESULTS/val
python3 analyze_google.py $P3_DATA/web-Google.bin $P3_DATA/web-Google.idmap $P3_RESULTS/val
python3 aggregate.py $P3_RESULTS
