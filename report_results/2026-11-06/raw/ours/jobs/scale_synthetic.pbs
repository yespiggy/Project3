#!/bin/bash
#PBS -N p3synscale
#PBS -q auto_free
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=64gb
#PBS -l walltime=00:45:00
#PBS -j oe
set -e -o pipefail
export P3_ROOT=/home/svu/e0985955/p3-review-20261102/Project3
source "$P3_ROOT/scripts/env.sh"
source "$P3_ROOT/scripts/run_lib.sh"
cd "$P3_ROOT"
check_node
NN=${NN:-1}
if [ "${#NODES[@]}" != "$NN" ]; then exit 1; fi
PERF="--iters 20 --tol 0 --reps 3"
if [ "$NN" = 1 ]; then
 counts="$CORES_1NODE"
else
 counts="$((NN * CPN))"
fi
strong "$P3_DATA/rmat_p144.bin" "$P3_RESULTS/strong_n${NN}_synthetic.csv" $counts
weak "$P3_RESULTS/weak_n${NN}.csv" $counts
if [ "$NN" = 1 ]; then
 "$BIN/pagerank_serial" --graph "$P3_DATA/rmat_p144.bin" $PERF --exp E5_serial --header 1 > "$P3_RESULTS/serial.csv"
fi
