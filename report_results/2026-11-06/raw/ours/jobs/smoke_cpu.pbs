#!/bin/bash
#PBS -N p3smoke
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mpiprocs=4:mem=4gb
#PBS -l walltime=00:10:00
#PBS -j oe
set -e -o pipefail
export P3_ROOT=/home/svu/e0985955/p3-review-20261102/Project3
source "$P3_ROOT/scripts/env.sh"
cd "$P3_ROOT"
source scripts/run_lib.sh
ensure_build
export OMP_NUM_THREADS=1
hostname
lscpu | head -20
.venv/bin/python tools/smoke.py --serial bin/pagerank_serial --mpi bin/pagerank_mpi_omp
