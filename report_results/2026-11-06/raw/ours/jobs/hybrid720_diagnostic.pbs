#!/bin/bash
#PBS -N p3hyb720diag
#PBS -l select=10:ncpus=72:mpiprocs=72:mem=64gb
#PBS -l place=scatter
#PBS -l walltime=00:10:00
#PBS -j oe

set -e -o pipefail

export P3_ROOT="$HOME/p3-review-20261102/Project3"
source "$P3_ROOT/scripts/env.sh"
source "$P3_ROOT/scripts/run_lib.sh"
cd "$P3_ROOT"

check_node

if [ "${#NODES[@]}" -ne 10 ]; then
    echo "ERROR: expected 10 nodes" >&2
    exit 1
fi

GRAPH="$P3_DATA/rmat_p144.bin"
test -s "$GRAPH"
test -x "$BIN/pagerank_mpi_omp"

OUT="$P3_RESULTS/hybrid720_diag_${PBS_JOBID}"
mkdir -p "$OUT"

# Record software and the actual PBS allocation.
mpirun --version > "$OUT/mpi_version.txt"
qstat -f "$PBS_JOBID" > "$OUT/job.txt" 2>&1 || true

# Read-only diagnostics on allocated compute nodes.
# These are snapshots, not a measurement of the earlier failure.
for host in "${NODES[@]}"; do
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" '
        hostname
        echo "Ephemeral port range:"
        cat /proc/sys/net/ipv4/ip_local_port_range
        echo "Reserved ports:"
        cat /proc/sys/net/ipv4/ip_local_reserved_ports
        echo "Open-file limit in this SSH shell:"
        ulimit -n
        echo "Socket summary:"
        ss -s
    ' > "$OUT/network_${host}.txt" 2>&1 || true
done

# Same graph, damping defaults and 20 iterations as the earlier runs.
# Five measured repetitions; the program also performs a warm-up.
for rpn in 2 4 8; do
    threads=$((72 / rpn))
    echo "Testing: 10 nodes, $rpn ranks/node, $threads threads/rank"

    run_mpi 10 "$rpn" "$threads" "$OUT/runs.csv" \
        "$BIN/pagerank_mpi_omp" \
        --graph "$GRAPH" \
        --part edge \
        --comm ghost \
        --iters 20 \
        --tol 0 \
        --reps 5 \
        --exp hybrid720_diag
done

echo "Completed successfully. Results: $OUT"
