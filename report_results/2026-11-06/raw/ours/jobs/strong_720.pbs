#!/bin/bash
# No queue directive: use the site's default routing, as advised by Prof. Chen.
#PBS -N p3strong720
#PBS -l select=10:ncpus=72:mpiprocs=72:mem=64gb
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -j oe
set -e -o pipefail
export P3_ROOT=/home/svu/e0985955/p3-review-20261102/Project3
source "$P3_ROOT/scripts/env.sh"
source "$P3_ROOT/scripts/run_lib.sh"
cd "$P3_ROOT"
check_node
if [ "${#NODES[@]}" -ne 10 ]; then
  echo "ERROR: expected ten allocated nodes" >&2
  exit 1
fi
test -x "$BIN/pagerank_mpi_omp"
test -s "$P3_DATA/rmat_p144.bin"
# Same graph and iteration/repetition counts as the existing 1–144 core suite.
# This is strong scaling only; weak scaling at 720 needs a separate larger graph.
PERF="--iters 20 --tol 0 --reps 3"
strong "$P3_DATA/rmat_p144.bin" "$P3_RESULTS/strong_n10_synthetic_${PBS_JOBID}.csv" 720
