#!/bin/bash
#PBS -N p3strong256
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=64gb
#PBS -l place=scatter
#PBS -l walltime=00:20:00
#PBS -j oe

set -e -o pipefail
export P3_ROOT="$HOME/p3-review-20261102/Project3"
source "$P3_ROOT/scripts/env.sh"
source "$P3_ROOT/scripts/run_lib.sh"
cd "$P3_ROOT"

test "${#NODES[@]}" -eq 4
GRAPH="$P3_DATA/rmat_p144.bin"
test -s "$GRAPH"
test -x "$BIN/pagerank_mpi_omp"

OUT="$P3_RESULTS/strong_n4_c256_${PBS_JOBID}.csv"

# Hybrid: 4 nodes × 2 ranks × 32 threads = 256 cores
run_mpi 4 2 32 "$OUT" "$BIN/pagerank_mpi_omp" \
    --graph "$GRAPH" --part edge --comm ghost \
    --iters 20 --tol 0 --reps 3 --exp E1_hybrid

# Pure MPI: 4 nodes × 64 ranks = 256 cores
run_mpi 4 64 1 "$OUT" "$BIN/pagerank_mpi_omp" \
    --graph "$GRAPH" --part edge --comm ghost \
    --iters 20 --tol 0 --reps 3 --exp E1_mpi
