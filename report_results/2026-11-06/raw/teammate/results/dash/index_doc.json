{"text": "<style>\n.pr { display: flex; flex-direction: column; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); font-variant-numeric: tabular-nums; }\n.pr h1 { margin: 0; font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); }\n.pr h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n.pr h3 { margin: 0; font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); }\n.pr p { margin: 0; }\n.pr .muted { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.pr-head { display: flex; flex-direction: column; gap: var(--cds-gap-sm); }\n.pr-take { max-width: 70ch; }\n.pr-take b, .pr-tile b { font-weight: 600; }\n.pr-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: var(--cds-gap-md); }\n.pr-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md); display: flex; flex-direction: column; gap: var(--cds-gap-xs); }\n.pr-tile .big { font-family: var(--font-anthropic-serif); font-size: var(--cds-font-size-title); line-height: 1.1; }\n.pr-nav { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); font-size: var(--cds-font-size-caption); }\n.pr-nav a { color: var(--color-fg-muted); text-decoration: none; border: 1px solid var(--color-border-line); border-radius: 999px; padding: 2px 10px; }\n.pr-nav a:hover { color: var(--color-fg); }\n.pr-sec { display: flex; flex-direction: column; gap: var(--cds-gap-md); scroll-margin-top: 16px; }\n.pr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }\n.pr-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n.pr-chart { position: relative; min-height: 260px; }\n.pr-chart svg { display: block; overflow: visible; }\n.pr-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; display: none; z-index: 2; }\n.pr-tip .h { color: var(--cds-text-secondary); margin-bottom: 2px; }\n.pr-tip .sw { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; }\n.pr-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.pr-legend i { display: inline-block; width: 14px; height: 3px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }\n.pr-tablebox { overflow: auto; max-height: 420px; }\n.pr table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); }\n.pr th, .pr td { text-align: right; padding: 6px 10px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.pr th:first-child, .pr td:first-child, .pr th.l, .pr td.l { text-align: left; }\n.pr th { position: sticky; top: 0; background: var(--color-panel); color: var(--color-fg-muted); font-weight: 500; }\n.pr .ok { color: var(--color-ok); }\n.pr .bad { color: var(--color-bad); }\n.pr-search { font: inherit; font-size: var(--cds-font-size-caption); padding: 4px 8px; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); max-width: 260px; }\n.pr-fail { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 260px; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.pr-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n.pr [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n.pr [data-dash-source-state=empty] { color: transparent; }\n</style>\n\n<div class=\"pr\">\n  <header class=\"pr-head\">\n    <h1>PageRank 实验数据</h1>\n    <p class=\"pr-take\">在 LiveJournal 上，单张 A40 每轮迭代比串行快 <b data-source=\"e5\" data-field=\"speedup_vs_serial\" data-where=\"platform=a40\" class=\"dash-skeleton\">—</b> 倍，64 核 CPU 快 <b data-source=\"e5\" data-field=\"speedup_vs_serial\" data-where=\"platform=node64\" class=\"dash-skeleton\">—</b> 倍。8 种并行实现与串行结果的最大 L1 误差为 <b data-source=\"val_max_l1\" data-field=\"max_l1\" data-row=\"0\" class=\"dash-skeleton\">—</b>。</p>\n    <p class=\"muted\">所有运行在 NUS HPC Vanda 上完成（CPU 节点 Xeon Gold 6438N，每节点使用 16 核；GPU 为 NVIDIA A40）。性能实验每个配置跑 5 次取中位数，每次固定 50 轮迭代。</p>\n  </header>\n\n  <div class=\"pr-tiles\">\n    <div class=\"pr-tile\"><span class=\"muted\">串行每轮耗时</span><span class=\"big\"><span data-source=\"e5\" data-field=\"t_iter_ms\" data-where=\"platform=serial\" class=\"dash-skeleton\">—</span> ms</span><span class=\"muted\">LiveJournal，1 核</span></div>\n    <div class=\"pr-tile\"><span class=\"muted\">1 个节点（16 核）加速比</span><span class=\"big\"><span data-source=\"e5\" data-field=\"speedup_vs_serial\" data-where=\"platform=node16\" class=\"dash-skeleton\">—</span>×</span><span class=\"muted\">MPI+OpenMP</span></div>\n    <div class=\"pr-tile\"><span class=\"muted\">4 个节点（64 核）加速比</span><span class=\"big\"><span data-source=\"e5\" data-field=\"speedup_vs_serial\" data-where=\"platform=node64\" class=\"dash-skeleton\">—</span>×</span><span class=\"muted\">相对串行</span></div>\n    <div class=\"pr-tile\"><span class=\"muted\">1× A40 加速比</span><span class=\"big\"><span data-source=\"e5\" data-field=\"speedup_vs_serial\" data-where=\"platform=a40\" class=\"dash-skeleton\">—</span>×</span><span class=\"muted\">cuSPARSE kernel</span></div>\n  </div>\n\n  <nav class=\"pr-nav\" aria-label=\"章节\">\n    <a href=\"#sec-val\">正确性</a><a href=\"#sec-e1\">E1 强扩展</a><a href=\"#sec-e2\">E2 弱扩展</a><a href=\"#sec-e3\">E3 设计对比</a><a href=\"#sec-e4\">E4 GPU kernel</a><a href=\"#sec-e5\">E5 CPU vs GPU</a><a href=\"#sec-google\">web-Google 数据</a><a href=\"#sec-raw\">原始数据</a>\n  </nav>\n\n  <section class=\"pr-sec\" id=\"sec-val\">\n    <h2>正确性验证</h2>\n    <p class=\"muted\">web-Google 上迭代到 L1 残差 &lt; 1e-10。每种并行实现与串行 C++ 结果比较，串行结果再与 NetworkX 比较。NetworkX 的误差稍大，是因为它的收敛判据较松（tol × N）。</p>\n    <div class=\"pr-card\">\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-val\" data-source=\"validation\" data-row-key=\"impl\">\n          <thead><tr><th data-field=\"impl\">比较</th><th data-field=\"l1\">L1 误差</th><th data-field=\"linf\">最大单点误差</th><th data-field=\"top100_same\">Top-100 顺序一致</th><th data-field=\"top1000_overlap\">Top-1000 重合数</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pr-sec\" id=\"sec-e1\">\n    <h2>E1 · CPU 强扩展（LiveJournal）</h2>\n    <p class=\"muted\">按入边数划分、只交换 ghost 节点。纯 MPI 为每核 1 个 rank；MPI+OpenMP 为每节点 1 个 rank，线程填满该节点（每节点 16 核）。加速比相对同模式的 1 核运行。</p>\n    <div class=\"pr-grid\">\n      <div class=\"pr-card\">\n        <h3>加速比</h3><p class=\"muted\">双对数坐标，虚线为理想线性加速</p>\n        <div class=\"pr-chart\" id=\"ch-e1-speedup\" data-source=\"e1\"></div>\n      </div>\n      <div class=\"pr-card\">\n        <h3>每轮计算与通信时间</h3><p class=\"muted\">各 rank 中的最大值（ms）；单节点的 MPI+OpenMP 只有 1 个 rank，没有通信</p>\n        <div class=\"pr-chart\" id=\"ch-e1-break\" data-source=\"e1\"></div>\n      </div>\n    </div>\n    <div class=\"pr-card\">\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-e1\" data-source=\"e1\" data-row-key=\"config\">\n          <thead><tr><th data-field=\"config\">配置</th><th data-field=\"mode\" class=\"l\">模式</th><th data-field=\"cores\">核数</th><th data-field=\"nodes\">节点</th><th data-field=\"ranks\">rank</th><th data-field=\"threads\">线程/rank</th><th data-field=\"t_iter_ms\">每轮 (ms)</th><th data-field=\"t_comp_ms\">计算 (ms)</th><th data-field=\"t_comm_ms\">通信 (ms)</th><th data-field=\"speedup\">加速比</th><th data-field=\"efficiency\">并行效率</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pr-sec\" id=\"sec-e2\">\n    <h2>E2 · CPU 弱扩展（R-MAT，每核约 2M 条边）</h2>\n    <p class=\"muted\">MPI+OpenMP。弱扩展效率 = 1 核每轮耗时 ÷ p 核每轮耗时，理想值为 1。</p>\n    <div class=\"pr-grid\">\n      <div class=\"pr-card\">\n        <h3>弱扩展效率</h3><p class=\"muted\">虚线为理想值 1</p>\n        <div class=\"pr-chart\" id=\"ch-e2-eff\" data-source=\"e2\"></div>\n      </div>\n      <div class=\"pr-card\">\n        <h3>每轮耗时组成</h3><p class=\"muted\">ms；32 核起跨节点，出现通信</p>\n        <div class=\"pr-chart\" id=\"ch-e2-break\" data-source=\"e2\"></div>\n      </div>\n    </div>\n    <div class=\"pr-card\">\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-e2\" data-source=\"e2\" data-row-key=\"cores\">\n          <thead><tr><th data-field=\"cores\">核数</th><th data-field=\"nodes\">节点</th><th data-field=\"N\">节点数 N</th><th data-field=\"M\">边数 M</th><th data-field=\"edges_per_core_m\">每核边数 (M)</th><th data-field=\"t_iter_ms\">每轮 (ms)</th><th data-field=\"t_comp_ms\">计算 (ms)</th><th data-field=\"t_comm_ms\">通信 (ms)</th><th data-field=\"weak_efficiency\">弱扩展效率</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pr-sec\" id=\"sec-e3\">\n    <h2>E3 · CPU 设计对比（64 核 = 4 节点 × 16 rank）</h2>\n    <p class=\"muted\">2×2 组合：划分方式 × 通信方式，纯 MPI，LiveJournal。负载不均衡度 = 各 rank 边数的最大值 ÷ 平均值。</p>\n    <div class=\"pr-grid\">\n      <div class=\"pr-card\">\n        <h3>每轮耗时</h3><p class=\"muted\">ms</p>\n        <div class=\"pr-chart\" id=\"ch-e3-time\" data-source=\"e3\"></div>\n      </div>\n      <div class=\"pr-card\">\n        <h3>每轮通信量</h3><p class=\"muted\">所有 rank 合计接收的数据量（MB）</p>\n        <div class=\"pr-chart\" id=\"ch-e3-bytes\" data-source=\"e3\"></div>\n      </div>\n    </div>\n    <div class=\"pr-card\">\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-e3\" data-source=\"e3\" data-row-key=\"config\">\n          <thead><tr><th data-field=\"config\">配置</th><th data-field=\"partition\" class=\"l\">划分</th><th data-field=\"communication\" class=\"l\">通信</th><th data-field=\"t_iter_ms\">每轮 (ms)</th><th data-field=\"t_comp_ms\">计算 (ms)</th><th data-field=\"t_comm_ms\">通信 (ms)</th><th data-field=\"imbalance\">负载不均衡度</th><th data-field=\"comm_mb_iter\">通信量 (MB/轮)</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pr-sec\" id=\"sec-e4\">\n    <h2>E4 · GPU 单卡 kernel 对比（1× A40，LiveJournal）</h2>\n    <p class=\"muted\">整张图常驻显存。有效带宽按每轮的理论访存量估算，A40 峰值约 696 GB/s。Vanda 不开放 GPU 性能计数器，因此没有 Nsight 数据。</p>\n    <div class=\"pr-grid\">\n      <div class=\"pr-card\">\n        <h3>每轮耗时</h3><p class=\"muted\">ms，越短越好</p>\n        <div class=\"pr-chart\" id=\"ch-e4-time\" data-source=\"e4\"></div>\n      </div>\n      <div class=\"pr-card\">\n        <h3>有效带宽</h3><p class=\"muted\">GB/s</p>\n        <div class=\"pr-chart\" id=\"ch-e4-bw\" data-source=\"e4\"></div>\n      </div>\n    </div>\n    <div class=\"pr-card\">\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-e4\" data-source=\"e4\" data-row-key=\"kernel\">\n          <thead><tr><th data-field=\"kernel\">kernel</th><th data-field=\"name\" class=\"l\">说明</th><th data-field=\"t_iter_ms\">每轮 (ms)</th><th data-field=\"gbps\">有效带宽 (GB/s)</th><th data-field=\"pct_peak\">占峰值 (%)</th><th data-field=\"speedup_vs_serial\">相对串行</th><th data-field=\"t_load_s\">读图 (s)</th><th data-field=\"t_h2d_s\">拷贝到显存 (s)</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pr-sec\" id=\"sec-e5\">\n    <h2>E5 · CPU vs GPU（LiveJournal）</h2>\n    <p class=\"muted\">同一张图的每轮耗时。CPU 数据取 E1 中同核数下较快的模式，GPU 取 E4 中最快的 kernel。</p>\n    <div class=\"pr-grid\">\n      <div class=\"pr-card\">\n        <h3>相对串行的加速比</h3><p class=\"muted\">倍</p>\n        <div class=\"pr-chart\" id=\"ch-e5\" data-source=\"e5\"></div>\n      </div>\n      <div class=\"pr-card\">\n        <div class=\"pr-tablebox\">\n          <table id=\"tbl-e5\" data-source=\"e5\" data-row-key=\"platform\">\n            <thead><tr><th data-field=\"platform\">平台</th><th data-field=\"label\" class=\"l\">配置</th><th data-field=\"t_iter_ms\">每轮 (ms)</th><th data-field=\"gteps\">GTEPS</th><th data-field=\"speedup_vs_serial\">加速比</th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pr-sec\" id=\"sec-google\">\n    <h2>web-Google 的数据结论</h2>\n    <p class=\"muted\">来自串行版本收敛后的 PageRank 向量。web-Google 是 Google 2002 年公开的网页链接图，规模见页底“使用的图”。</p>\n    <div class=\"pr-tiles\">\n      <div class=\"pr-tile\"><span class=\"muted\">PageRank 与入度的 Spearman 相关</span><span class=\"big\" data-source=\"google_stats\" data-field=\"spearman\" data-row=\"0\">—</span></div>\n      <div class=\"pr-tile\"><span class=\"muted\">PageRank Top-100 与入度 Top-100 重合</span><span class=\"big\"><span data-source=\"google_stats\" data-field=\"top100_overlap\" data-row=\"0\">—</span> / 100</span></div>\n      <div class=\"pr-tile\"><span class=\"muted\">前 1% 页面占的 rank 总量</span><span class=\"big\" data-source=\"google_stats\" data-field=\"share_top1\" data-row=\"0\">—</span></div>\n      <div class=\"pr-tile\"><span class=\"muted\">dangling 页面（无出链）</span><span class=\"big\" data-source=\"google_stats\" data-field=\"dangling\" data-row=\"0\">—</span></div>\n    </div>\n    <div class=\"pr-grid\">\n      <div class=\"pr-card\">\n        <h3>入度分布</h3><p class=\"muted\">按 2 的幂分组的页面数，纵轴对数</p>\n        <div class=\"pr-chart\" id=\"ch-g-hist\" data-source=\"google_indeg\"></div>\n      </div>\n      <div class=\"pr-card\">\n        <h3>各入度区间的平均 PageRank</h3><p class=\"muted\">双对数坐标</p>\n        <div class=\"pr-chart\" id=\"ch-g-prdeg\" data-source=\"google_indeg\"></div>\n      </div>\n      <div class=\"pr-card\">\n        <h3>收敛过程</h3><p class=\"muted\">每轮 L1 残差，纵轴对数；虚线为收敛阈值 1e-10</p>\n        <div class=\"pr-chart\" id=\"ch-g-conv\" data-source=\"convergence\"></div>\n      </div>\n    </div>\n    <div class=\"pr-card\">\n      <h3>PageRank 最高的 15 个页面</h3>\n      <p class=\"muted\">节点编号为 SNAP 原始 ID；“入度排名”表示该页面按入度排第几</p>\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-gtop\" data-source=\"google_top\" data-row-key=\"rank\">\n          <thead><tr><th data-field=\"rank\">排名</th><th data-field=\"node\">节点</th><th data-field=\"pagerank\">PageRank</th><th data-field=\"indeg\">入度</th><th data-field=\"outdeg\">出度</th><th data-field=\"indeg_rank\">入度排名</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pr-sec\" id=\"sec-raw\">\n    <h2>原始数据</h2>\n    <div class=\"pr-card\">\n      <h3>使用的图</h3>\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-graphs\" data-source=\"graphs\" data-row-key=\"graph\">\n          <thead><tr><th data-field=\"graph\">图</th><th data-field=\"N\">节点数</th><th data-field=\"M\">边数</th><th data-field=\"dangling\">dangling 节点</th><th data-field=\"used_in\" class=\"l\">用于</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n    <div class=\"pr-card\">\n      <h3>全部运行记录</h3>\n      <input class=\"pr-search\" id=\"raw-search\" type=\"search\" placeholder=\"筛选，例如 E3 或 cuda\" aria-label=\"筛选运行记录\">\n      <div class=\"pr-tablebox\">\n        <table id=\"tbl-runs\" data-source=\"runs\" data-row-key=\"run_id\">\n          <thead><tr><th data-field=\"run_id\">记录</th><th data-field=\"exp\" class=\"l\">实验</th><th data-field=\"impl\" class=\"l\">实现</th><th data-field=\"graph\" class=\"l\">图</th><th data-field=\"nodes\">节点</th><th data-field=\"ranks\">rank</th><th data-field=\"threads\">线程</th><th data-field=\"part\" class=\"l\">划分</th><th data-field=\"comm\" class=\"l\">通信</th><th data-field=\"rep\">重复</th><th data-field=\"iters\">轮数</th><th data-field=\"t_iter_ms\">每轮 (ms)</th><th data-field=\"resid\">残差</th><th data-field=\"sumr\">Σr</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\nwindow.PR = (() => {\n  const css = (name) => getComputedStyle(document.getElementById('dash-root')).getPropertyValue(name).trim();\n  const fmtNum = (v, d) => (v == null || Number.isNaN(v)) ? '' : (typeof v === 'number' ? (Number.isInteger(v) && d == null ? d3.format(',')(v) : (d != null ? v.toFixed(d) : String(v))) : String(v));\n\n  function tipFor(box) {\n    let t = box.querySelector('.pr-tip');\n    if (!t) { t = document.createElement('div'); t.className = 'pr-tip'; box.appendChild(t); }\n    return t;\n  }\n  function showTip(box, html, x, y) {\n    const t = tipFor(box);\n    t.replaceChildren(...html);\n    t.style.display = 'block';\n    const w = t.offsetWidth, bw = box.clientWidth;\n    t.style.left = Math.max(0, Math.min(bw - w, x + 12)) + 'px';\n    t.style.top = Math.max(0, y - t.offsetHeight - 8) + 'px';\n  }\n  function hideTip(box) { const t = box.querySelector('.pr-tip'); if (t) t.style.display = 'none'; }\n  function line(text, color) {\n    const d = document.createElement('div');\n    if (color) { const s = document.createElement('span'); s.className = 'sw'; s.style.background = color; d.appendChild(s); }\n    d.appendChild(document.createTextNode(text));\n    return d;\n  }\n  function head(text) { const d = document.createElement('div'); d.className = 'h'; d.textContent = text; return d; }\n\n  function clear(box) {\n    box.querySelectorAll('svg, .pr-fail, .pr-legend').forEach((n) => n.remove());\n    hideTip(box);\n  }\n  function fail(box) { clear(box); box.classList.remove('dash-skeleton'); const f = document.createElement('div'); f.className = 'pr-fail'; f.textContent = 'Failed to load'; box.appendChild(f); }\n\n  function styleAxis(g) {\n    g.attr('font-size', null).attr('font-family', null);\n    g.selectAll('text').attr('fill', css('--color-fg-muted')).style('font-size', css('--cds-font-size-caption'));\n    g.selectAll('.domain').attr('stroke', css('--cds-chart-axis'));\n    g.selectAll('.tick line').attr('stroke', css('--cds-chart-axis'));\n  }\n  function textWidth(svg, texts) {\n    const t = svg.append('text').style('font-size', css('--cds-font-size-caption'));\n    let w = 0;\n    texts.forEach((s) => { t.text(s); w = Math.max(w, t.node().getComputedTextLength()); });\n    t.remove();\n    return w;\n  }\n\n  // Line chart. series: [{name, color, dash, rows:[{x,y,...}]}]; opts: logX, logY, xTicks, yFmt, xFmt, ref:[[x,y],...], refY, tipRows(x)\n  function lineChart(box, series, o) {\n    clear(box);\n    box.classList.remove('dash-skeleton');\n    const W = Math.max(280, box.clientWidth), H = 260;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const all = series.flatMap((s) => s.rows);\n    const xs = [...new Set(all.map((r) => r.x))].sort((a, b) => a - b);\n    let yMin = d3.min(all, (r) => r.y), yMax = d3.max(all, (r) => r.y);\n    if (o.ref) { yMin = Math.min(yMin, d3.min(o.ref, (p) => p[1])); yMax = Math.max(yMax, d3.max(o.ref, (p) => p[1])); }\n    if (o.refY != null) { yMin = Math.min(yMin, o.refY); yMax = Math.max(yMax, o.refY); }\n    const yScale0 = o.logY ? d3.scaleLog().base(o.logY).domain([yMin, yMax]).nice() : d3.scaleLinear().domain([o.yZero === false ? yMin : Math.min(0, yMin), yMax]).nice();\n    let yTicks = yScale0.ticks(5);\n    if (o.logY === 10) {\n      yTicks = yScale0.ticks().filter((v) => Math.abs(Math.log10(v) - Math.round(Math.log10(v))) < 1e-9);\n      if (yTicks.length > 6) yTicks = yTicks.filter((_, i) => i % 2 === 0);\n    } else if (o.logY === 2) {\n      yTicks = d3.range(Math.ceil(Math.log2(yScale0.domain()[0])), Math.floor(Math.log2(yScale0.domain()[1])) + 1).map((k) => 2 ** k);\n    }\n    const yFmt = o.yFmt || d3.format(',');\n    const ml = textWidth(svg, yTicks.map(yFmt)) + 14;\n    const m = { l: ml, r: 16, t: 10, b: 28 };\n    const x = (o.logX ? d3.scaleLog().base(o.logX) : d3.scaleLinear()).domain(d3.extent(xs)).range([m.l, W - m.r]);\n    const y = yScale0.range([H - m.b, m.t]);\n    svg.append('g').selectAll('line').data(yTicks).join('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', (d) => y(d)).attr('y2', (d) => y(d)).attr('stroke', css('--cds-chart-grid'));\n    const xTickVals = o.xTicks || xs;\n    const gx = svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).tickValues(xTickVals).tickFormat(o.xFmt || d3.format(',')).tickSizeOuter(0));\n    styleAxis(gx);\n    const gy = svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).tickValues(yTicks).tickFormat(yFmt).tickSize(0).tickPadding(8));\n    styleAxis(gy); gy.select('.domain').remove();\n    if (o.ref) svg.append('path').attr('d', d3.line().x((p) => x(p[0])).y((p) => y(p[1]))(o.ref)).attr('fill', 'none').attr('stroke', css('--cds-chart-reference')).attr('stroke-dasharray', '4 4');\n    if (o.refY != null) svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y(o.refY)).attr('y2', y(o.refY)).attr('stroke', css('--cds-chart-reference')).attr('stroke-dasharray', '4 4');\n    series.forEach((s) => {\n      svg.append('path').attr('d', d3.line().x((r) => x(r.x)).y((r) => y(r.y))(s.rows)).attr('fill', 'none').attr('stroke', s.color)\n        .attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round').attr('stroke-dasharray', s.dash || null);\n      if (!o.noDots) svg.append('g').selectAll('circle').data(s.rows).join('circle').attr('cx', (r) => x(r.x)).attr('cy', (r) => y(r.y)).attr('r', 3).attr('fill', s.color);\n    });\n    const hover = svg.append('g').style('display', 'none');\n    const rule = hover.append('line').attr('y1', m.t).attr('y2', H - m.b).attr('stroke', css('--cds-chart-axis'));\n    svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')\n      .on('mousemove', (ev) => {\n        const [px] = d3.pointer(ev);\n        const xv = xs.reduce((a, b) => Math.abs(x(b) - px) < Math.abs(x(a) - px) ? b : a);\n        hover.style('display', null); rule.attr('x1', x(xv)).attr('x2', x(xv));\n        hover.selectAll('circle').remove();\n        const lines = [head((o.xName || '') + (o.xFmt || d3.format(','))(xv))];\n        series.forEach((s) => {\n          const r = s.rows.find((q) => q.x === xv);\n          if (!r) return;\n          hover.append('circle').attr('cx', x(xv)).attr('cy', y(r.y)).attr('r', 5).attr('fill', s.color);\n          lines.push(line(`${s.name}：${(o.tipFmt || yFmt)(r.y)}${o.tipExtra ? o.tipExtra(r) : ''}`, series.length > 1 ? s.color : null));\n        });\n        const rect = box.getBoundingClientRect(), sr = svg.node().getBoundingClientRect();\n        showTip(box, lines, x(xv) * sr.width / W, d3.pointer(ev, box)[1]);\n      })\n      .on('mouseleave', () => { hover.style('display', 'none'); hideTip(box); });\n    if (series.length > 1 || o.legendRef) {\n      const lg = document.createElement('div'); lg.className = 'pr-legend';\n      series.forEach((s) => { const sp = document.createElement('span'); const i = document.createElement('i'); i.style.background = s.color; if (s.dash) i.style.opacity = '.6'; sp.append(i, s.name); lg.appendChild(sp); });\n      if (o.legendRef) { const sp = document.createElement('span'); const i = document.createElement('i'); i.style.background = css('--cds-chart-reference'); sp.append(i, o.legendRef); lg.appendChild(sp); }\n      box.appendChild(lg);\n    }\n  }\n\n  // Horizontal bars. rows:[{label, segs:[{name, value, color}]}]\n  function hbar(box, rows, o) {\n    clear(box);\n    box.classList.remove('dash-skeleton');\n    const W = Math.max(280, box.clientWidth), bh = 26, gap = 14;\n    const H = rows.length * (bh + gap) + 30;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const fmt = o.fmt || d3.format(',');\n    const ml = textWidth(svg, rows.map((r) => r.label)) + 12;\n    const totals = rows.map((r) => d3.sum(r.segs, (s) => s.value));\n    const mr = textWidth(svg, totals.map(fmt)) + 12;\n    const x = d3.scaleLinear().domain([0, d3.max(totals) || 1]).nice().range([ml, W - mr]);\n    const ticks = x.ticks(4);\n    svg.append('g').selectAll('line').data(ticks).join('line').attr('x1', (d) => x(d)).attr('x2', (d) => x(d)).attr('y1', 0).attr('y2', H - 24).attr('stroke', css('--cds-chart-grid'));\n    const gx = svg.append('g').attr('transform', `translate(0,${H - 24})`).call(d3.axisBottom(x).tickValues(ticks).tickFormat(d3.format(',')).tickSize(0).tickPadding(6));\n    styleAxis(gx); gx.select('.domain').remove();\n    rows.forEach((r, i) => {\n      const yy = i * (bh + gap) + 4;\n      svg.append('text').attr('x', ml - 8).attr('y', yy + bh / 2).attr('dy', '0.35em').attr('text-anchor', 'end').attr('fill', css('--color-fg')).style('font-size', css('--cds-font-size-caption')).text(r.label);\n      let acc = 0;\n      r.segs.forEach((s) => {\n        const x0 = x(acc), x1 = x(acc + s.value);\n        svg.append('rect').attr('x', x0).attr('y', yy).attr('width', Math.max(0, x1 - x0)).attr('height', bh).attr('rx', r.segs.length > 1 ? 0 : 4).attr('fill', s.color)\n          .on('mousemove', (ev) => {\n            const p = d3.pointer(ev, box);\n            showTip(box, [head(r.label), ...r.segs.map((q) => line(`${q.name}：${fmt(q.value)}`, r.segs.length > 1 ? q.color : null)), ...(r.extra ? [line(r.extra)] : [])], p[0], p[1]);\n          })\n          .on('mouseleave', () => hideTip(box));\n        acc += s.value;\n      });\n      svg.append('text').attr('x', x(acc) + 6).attr('y', yy + bh / 2).attr('dy', '0.35em').attr('fill', css('--color-fg-muted')).style('font-size', css('--cds-font-size-caption')).text(fmt(totals[i]));\n    });\n    if (o.legend) {\n      const lg = document.createElement('div'); lg.className = 'pr-legend';\n      o.legend.forEach(([n, c]) => { const sp = document.createElement('span'); const i = document.createElement('i'); i.style.background = c; sp.append(i, n); lg.appendChild(sp); });\n      box.appendChild(lg);\n    }\n  }\n\n  // Vertical bars with optional log y. rows:[{label, value}]\n  function vbar(box, rows, o) {\n    clear(box);\n    box.classList.remove('dash-skeleton');\n    const W = Math.max(280, box.clientWidth), H = 260;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const y0 = o.logY ? d3.scaleLog().domain([1, d3.max(rows, (r) => r.value)]).nice() : d3.scaleLinear().domain([0, d3.max(rows, (r) => r.value)]).nice();\n    const yTicks = o.logY ? y0.ticks().filter((v) => Math.log10(v) % 1 === 0) : y0.ticks(5);\n    const yFmt = d3.format('~s');\n    const m = { l: textWidth(svg, yTicks.map(yFmt)) + 14, r: 8, t: 10, b: 44 };\n    const x = d3.scaleBand().domain(rows.map((r) => r.label)).range([m.l, W - m.r]).padding(0.2);\n    const y = y0.range([H - m.b, m.t]);\n    svg.append('g').selectAll('line').data(yTicks).join('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', (d) => y(d)).attr('y2', (d) => y(d)).attr('stroke', css('--cds-chart-grid'));\n    const gy = svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).tickValues(yTicks).tickFormat(yFmt).tickSize(0).tickPadding(8));\n    styleAxis(gy); gy.select('.domain').remove();\n    const every = Math.ceil(rows.length / Math.max(1, Math.floor((W - m.l) / 46)));\n    const gx = svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).tickValues(rows.map((r) => r.label).filter((_, i) => i % every === 0)).tickSizeOuter(0));\n    styleAxis(gx);\n    gx.selectAll('text').attr('transform', 'rotate(-35)').attr('text-anchor', 'end').attr('dx', '-0.4em').attr('dy', '0.6em');\n    svg.append('g').selectAll('rect').data(rows).join('rect').attr('x', (r) => x(r.label)).attr('width', x.bandwidth())\n      .attr('y', (r) => y(Math.max(o.logY ? 1 : 0, r.value))).attr('height', (r) => y(o.logY ? 1 : 0) - y(Math.max(o.logY ? 1 : 0, r.value)))\n      .attr('rx', 3).attr('fill', o.color)\n      .on('mousemove', (ev, r) => { const p = d3.pointer(ev, box); showTip(box, [head(o.xName + r.label), line(o.tip(r))], p[0], p[1]); })\n      .on('mouseleave', () => hideTip(box));\n  }\n\n  // Table body from rows; cols: [{field, fmt}] in header order.\n  function table(tbl, rows, cols, filter) {\n    const tb = tbl.querySelector('tbody');\n    tb.replaceChildren();\n    rows.filter(filter || (() => true)).forEach((r) => {\n      const tr = document.createElement('tr');\n      cols.forEach((c, i) => {\n        const td = document.createElement('td');\n        if (tbl.querySelectorAll('thead th')[i].classList.contains('l')) td.className = 'l';\n        const v = r[c.field];\n        td.textContent = c.fmt ? c.fmt(v, r) : fmtNum(v);\n        if (c.cls) td.classList.add(c.cls(v, r));\n        tr.appendChild(td);\n      });\n      tb.appendChild(tr);\n    });\n  }\n\n  return { css, lineChart, hbar, vbar, table, fail, fmtNum };\n})();\n</script>\n\n<script>\ndash.calc('val_max_l1', {\n  title: '最大验证误差',\n  description: '8 种并行实现（MPI 4 种 + CUDA 4 种）与串行结果之间 L1 误差的最大值。',\n  inputs: ['validation'],\n  fn: (validation) => [{ max_l1: Math.max(...validation.filter((r) => r.impl.endsWith('vs 串行')).map((r) => r.l1)) }],\n});\n\n(() => {\n  const e = (v) => v == null ? '' : v.toExponential(2);\n  const f = (d) => (v) => v == null ? '' : v.toFixed(d);\n  const int = (v) => v == null ? '' : d3.format(',')(v);\n  const pct = (v) => v == null ? '' : d3.format('.1%')(v);\n  const C = () => dash.colors;\n  const ok = (id) => dash.data(id).status === 'ok';\n  const box = (id) => document.getElementById(id);\n\n  const fillText = () => {\n    document.querySelectorAll('.pr [data-source][data-field]').forEach((el) => {\n      if (el.tagName === 'TH' || el.closest('table')) return;\n      const d = dash.data(el.dataset.source);\n      if (d.status !== 'ok') return;\n      const rows = d.data;\n      let row = null;\n      if (el.dataset.row != null) row = rows[+el.dataset.row];\n      else if (el.dataset.where) {\n        const [k, v] = el.dataset.where.split('=');\n        row = rows.find((r) => String(r[k]) === decodeURIComponent(v));\n      }\n      if (!row) return;\n      const v = row[el.dataset.field];\n      const fld = el.dataset.field;\n      el.textContent = fld === 'max_l1' ? v.toExponential(2) : fld.startsWith('share') ? pct(v) : fld === 'dangling' ? int(v) : String(v);\n      el.classList.remove('dash-skeleton');\n    });\n  };\n\n  const charts = [\n    ['ch-e1-speedup', ['e1']], ['ch-e1-break', ['e1']], ['ch-e2-eff', ['e2']], ['ch-e2-break', ['e2']],\n    ['ch-e3-time', ['e3']], ['ch-e3-bytes', ['e3']], ['ch-e4-time', ['e4']], ['ch-e4-bw', ['e4']], ['ch-e5', ['e5']],\n    ['ch-g-hist', ['google_indeg']], ['ch-g-prdeg', ['google_indeg']], ['ch-g-conv', ['convergence']],\n  ];\n\n  function draw() {\n    fillText();\n    charts.forEach(([id, srcs]) => {\n      const st = srcs.map((s) => dash.data(s).status);\n      if (st.some((s) => s === 'error' || s === 'connect' || s === 'missing')) PR.fail(box(id));\n      else if (st.some((s) => s !== 'ok')) box(id).classList.add('dash-skeleton');\n    });\n    const cores = [1, 2, 4, 8, 16, 32, 64];\n\n    if (ok('validation')) PR.table(box('tbl-val'), dash.data('validation').data, [\n      { field: 'impl' }, { field: 'l1', fmt: e }, { field: 'linf', fmt: e },\n      { field: 'top100_same', fmt: (v) => v ? '是' : '否', cls: (v) => v ? 'ok' : 'bad' }, { field: 'top1000_overlap', fmt: int }]);\n\n    if (ok('e1')) {\n      const rows = dash.data('e1').data;\n      const by = (mode, key) => rows.filter((r) => r.mode === mode).sort((a, b) => a.cores - b.cores).map((r) => ({ ...r, x: r.cores, y: r[key] }));\n      PR.lineChart(box('ch-e1-speedup'), [\n        { name: '纯 MPI', color: C()[0], rows: by('纯 MPI', 'speedup') },\n        { name: 'MPI+OpenMP', color: C()[1], rows: by('MPI+OpenMP', 'speedup') }],\n        { logX: 2, logY: 2, xTicks: cores, ref: cores.map((c) => [c, c]), xName: '核数 ', yFmt: d3.format('~g'), tipFmt: (v) => v.toFixed(2) + '×',\n          tipExtra: (r) => `（${r.t_iter_ms.toFixed(2)} ms）`, legendRef: '理想线性加速' });\n      PR.lineChart(box('ch-e1-break'), [\n        { name: '纯 MPI 计算', color: C()[0], rows: by('纯 MPI', 't_comp_ms') },\n        { name: '纯 MPI 通信', color: C()[0], dash: '5 4', rows: by('纯 MPI', 't_comm_ms') },\n        { name: 'MPI+OpenMP 计算', color: C()[1], rows: by('MPI+OpenMP', 't_comp_ms') },\n        { name: 'MPI+OpenMP 通信', color: C()[1], dash: '5 4', rows: by('MPI+OpenMP', 't_comm_ms') }],\n        { logX: 2, xTicks: cores, xName: '核数 ', yFmt: d3.format(','), tipFmt: (v) => v.toFixed(2) + ' ms' });\n      PR.table(box('tbl-e1'), rows.slice().sort((a, b) => a.mode.localeCompare(b.mode) || a.cores - b.cores), [\n        { field: 'config' }, { field: 'mode' }, { field: 'cores', fmt: int }, { field: 'nodes', fmt: int }, { field: 'ranks', fmt: int },\n        { field: 'threads', fmt: int }, { field: 't_iter_ms', fmt: f(2) }, { field: 't_comp_ms', fmt: f(2) }, { field: 't_comm_ms', fmt: f(2) },\n        { field: 'speedup', fmt: f(2) }, { field: 'efficiency', fmt: pct }]);\n    }\n\n    if (ok('e2')) {\n      const rows = dash.data('e2').data.slice().sort((a, b) => a.cores - b.cores);\n      PR.lineChart(box('ch-e2-eff'), [{ name: '弱扩展效率', color: C()[1], rows: rows.map((r) => ({ ...r, x: r.cores, y: r.weak_efficiency })) }],\n        { logX: 2, xTicks: cores, refY: 1, xName: '核数 ', yFmt: d3.format('.0%'), tipFmt: pct, tipExtra: (r) => `（${r.t_iter_ms.toFixed(2)} ms，M = ${d3.format('.3s')(r.M)}）` });\n      PR.lineChart(box('ch-e2-break'), [\n        { name: '计算', color: C()[1], rows: rows.map((r) => ({ x: r.cores, y: r.t_comp_ms })) },\n        { name: '通信', color: C()[1], dash: '5 4', rows: rows.map((r) => ({ x: r.cores, y: r.t_comm_ms })) },\n        { name: '每轮总计', color: C()[2], rows: rows.map((r) => ({ x: r.cores, y: r.t_iter_ms })) }],\n        { logX: 2, xTicks: cores, xName: '核数 ', tipFmt: (v) => v.toFixed(2) + ' ms' });\n      PR.table(box('tbl-e2'), rows, [{ field: 'cores', fmt: int }, { field: 'nodes', fmt: int }, { field: 'N', fmt: int }, { field: 'M', fmt: int },\n        { field: 'edges_per_core_m', fmt: f(2) }, { field: 't_iter_ms', fmt: f(2) }, { field: 't_comp_ms', fmt: f(2) }, { field: 't_comm_ms', fmt: f(2) },\n        { field: 'weak_efficiency', fmt: pct }]);\n    }\n\n    if (ok('e3')) {\n      const order = ['vertex+allgather', 'vertex+ghost', 'edge+allgather', 'edge+ghost'];\n      const rows = dash.data('e3').data.slice().sort((a, b) => order.indexOf(a.config) - order.indexOf(b.config));\n      const best = d3.min(rows, (r) => r.t_iter_ms);\n      PR.hbar(box('ch-e3-time'), rows.map((r) => ({ label: `${r.partition} + ${r.communication}`,\n        segs: [{ name: '每轮', value: r.t_iter_ms, color: r.t_iter_ms === best ? C()[0] : PR.css('--cds-chart-muted') }],\n        extra: `计算 ${r.t_comp_ms.toFixed(2)} ms，通信 ${r.t_comm_ms.toFixed(2)} ms，不均衡度 ${r.imbalance.toFixed(3)}` })), { fmt: (v) => v.toFixed(2) });\n      PR.hbar(box('ch-e3-bytes'), rows.map((r) => ({ label: `${r.partition} + ${r.communication}`,\n        segs: [{ name: '通信量', value: r.comm_mb_iter, color: r.communication === 'Allgatherv' ? PR.css('--cds-chart-muted') : C()[0] }] })), { fmt: (v) => d3.format(',.0f')(v) });\n      PR.table(box('tbl-e3'), rows, [{ field: 'config' }, { field: 'partition' }, { field: 'communication' }, { field: 't_iter_ms', fmt: f(2) },\n        { field: 't_comp_ms', fmt: f(2) }, { field: 't_comm_ms', fmt: f(2) }, { field: 'imbalance', fmt: f(3) }, { field: 'comm_mb_iter', fmt: f(1) }]);\n    }\n\n    if (ok('e4')) {\n      const rows = dash.data('e4').data.slice().sort((a, b) => a.t_iter_ms - b.t_iter_ms);\n      const best = rows[0].kernel;\n      const col = (r) => r.kernel === best ? C()[3] : PR.css('--cds-chart-muted');\n      PR.hbar(box('ch-e4-time'), rows.map((r) => ({ label: r.name, segs: [{ name: '每轮', value: r.t_iter_ms, color: col(r) }] })), { fmt: (v) => v.toFixed(2) });\n      PR.hbar(box('ch-e4-bw'), rows.map((r) => ({ label: r.name, segs: [{ name: '有效带宽', value: r.gbps, color: col(r) }], extra: `占 A40 峰值 ${r.pct_peak}%` })), { fmt: (v) => d3.format(',.0f')(v) });\n      PR.table(box('tbl-e4'), rows, [{ field: 'kernel' }, { field: 'name' }, { field: 't_iter_ms', fmt: f(3) }, { field: 'gbps', fmt: f(1) },\n        { field: 'pct_peak', fmt: f(1) }, { field: 'speedup_vs_serial', fmt: f(1) }, { field: 't_load_s', fmt: f(2) }, { field: 't_h2d_s', fmt: f(3) }]);\n    }\n\n    if (ok('e5')) {\n      const rows = dash.data('e5').data;\n      PR.hbar(box('ch-e5'), rows.map((r) => ({ label: r.label, segs: [{ name: '加速比', value: r.speedup_vs_serial, color: r.platform === 'a40' ? C()[3] : r.platform === 'serial' ? PR.css('--cds-chart-muted') : C()[1] }],\n        extra: `每轮 ${r.t_iter_ms} ms，${r.gteps} GTEPS` })), { fmt: (v) => v.toFixed(1) + '×' });\n      PR.table(box('tbl-e5'), rows, [{ field: 'platform' }, { field: 'label' }, { field: 't_iter_ms', fmt: f(2) }, { field: 'gteps', fmt: f(3) }, { field: 'speedup_vs_serial', fmt: f(1) }]);\n    }\n\n    if (ok('google_indeg')) {\n      const rows = dash.data('google_indeg').data.slice().sort((a, b) => a.lo - b.lo);\n      PR.vbar(box('ch-g-hist'), rows.map((r) => ({ label: r.bin, value: r.count })), { logY: true, color: C()[2], xName: '入度 ', tip: (r) => `${d3.format(',')(r.value)} 个页面` });\n      const pos = rows.filter((r) => r.lo > 0);\n      PR.lineChart(box('ch-g-prdeg'), [{ name: '平均 PageRank', color: C()[2], rows: pos.map((r) => ({ ...r, x: r.lo, y: r.mean_pr })) }],\n        { logX: 2, logY: 10, xTicks: pos.map((r) => r.lo).filter((_, i) => i % 2 === 0), xName: '入度 ≥ ', yFmt: d3.format('.0e'), tipFmt: (v) => v.toExponential(2), tipExtra: (r) => `（${d3.format(',')(r.count)} 个页面）` });\n    }\n    if (ok('convergence')) {\n      const rows = dash.data('convergence').data;\n      PR.lineChart(box('ch-g-conv'), [{ name: 'L1 残差', color: C()[0], rows: rows.map((r) => ({ x: r.iter, y: r.resid })) }],\n        { logY: 10, refY: 1e-10, noDots: true, xTicks: [1, 20, 40, 60, 80, 100, 118], xName: '第 ', yFmt: d3.format('.0e'), tipFmt: (v) => v.toExponential(2), yZero: false });\n    }\n    if (ok('google_top')) PR.table(box('tbl-gtop'), dash.data('google_top').data, [{ field: 'rank' }, { field: 'node' }, { field: 'pagerank', fmt: e },\n      { field: 'indeg', fmt: int }, { field: 'outdeg', fmt: int }, { field: 'indeg_rank', fmt: int }]);\n    if (ok('graphs')) PR.table(box('tbl-graphs'), dash.data('graphs').data, [{ field: 'graph' }, { field: 'N', fmt: int }, { field: 'M', fmt: int },\n      { field: 'dangling', fmt: int }, { field: 'used_in' }]);\n    if (ok('runs')) {\n      const q = (box('raw-search').value || '').trim().toLowerCase();\n      PR.table(box('tbl-runs'), dash.data('runs').data, [{ field: 'run_id' }, { field: 'exp' }, { field: 'impl' }, { field: 'graph' }, { field: 'nodes' },\n        { field: 'ranks' }, { field: 'threads' }, { field: 'part' }, { field: 'comm' }, { field: 'rep' }, { field: 'iters' }, { field: 't_iter_ms', fmt: f(3) },\n        { field: 'resid', fmt: e }, { field: 'sumr', fmt: f(12) }], (r) => !q || Object.values(r).join(' ').toLowerCase().includes(q));\n    }\n  }\n\n  box('raw-search').addEventListener('input', draw);\n  dash.onData(draw);\n})();\n</script>\n"}